import java.util.*;

class Solution {
    
    public boolean isCycle(int V, int[][] edges) {

        List<List<Integer>> adj = new ArrayList<>();
        for(int i = 0; i < V; i++){
            adj.add(new ArrayList<>());
        }

        // build graph
        for(int[] e : edges){
            int u = e[0];
            int v = e[1];
            adj.get(u).add(v);
            adj.get(v).add(u);
        }

        boolean[] visited = new boolean[V];

        for(int i = 0; i < V; i++){
            if(!visited[i]){
                if(bfs(i, adj, visited))
                    return true;
            }
        }
        return false;
    }

    boolean bfs(int start, List<List<Integer>> adj, boolean[] visited){

        Queue<int[]> q = new LinkedList<>();
        q.add(new int[]{start, -1});
        visited[start] = true;

        while(!q.isEmpty()){
            int[] cur = q.poll();
            int node = cur[0];
            int parent = cur[1];

            for(int next : adj.get(node)){
                if(!visited[next]){
                    visited[next] = true;
                    q.add(new int[]{next, node});
                }
                else if(next != parent){
                    return true;   // cycle found
                }
            }
        }
        return false;
    }
}
